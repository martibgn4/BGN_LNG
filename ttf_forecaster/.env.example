# Copy to .env (git-ignored) and fill locally. Placeholders only — never commit values.

# Bloomberg Desktop API uses the logged-in Terminal; host/port only for a Server API (SAPI/B-PIPE).
BLOOMBERG_HOST=
BLOOMBERG_PORT=

# Spark Commodities: OAuth2 client credentials (see docs/modelling_log.md D-007).
SPARK_CLIENT_ID=
SPARK_CLIENT_SECRET=
SPARK_BASE_URL=

# Optional: root for the local data store (defaults to ./data).
TTF_DATA_ROOT=

# Licensed / proprietary data never enters Git. All of data/ is regenerated by the pipeline.
/data/
!/data/.gitkeep
outputs/
mlruns/
*.parquet
*.feather
*.duckdb

# Local configuration and secrets
.env
.env.*
!.env.example
configs/local*.yaml
*credentials*
*.secret

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
.venv/
build/
dist/

# Notebooks: outputs may contain licensed data
.ipynb_checkpoints/
